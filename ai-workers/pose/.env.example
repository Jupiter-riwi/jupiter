# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/
POSE_JOBS_QUEUE=pose.jobs
FEATURES_RESULTS_QUEUE=features.results

# Postgres / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# S3 / MinIO
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Pose worker
POSE_WORKER_NAME=pose-worker
POSE_SEGMENT_SECONDS=5
POSE_MAX_VIDEO_SECONDS=600
POSE_MAX_PEOPLE=1
POSE_SHOULDER_OPEN_THRESHOLD=0.16
POSE_DETECTION_CONFIDENCE=0.5
POSE_TRACKING_CONFIDENCE=0.5
POSE_EYE_CONTACT_YAW_THRESHOLD=0.35
POSE_HAND_MOTION_THRESHOLD=0.08
POSE_TEMP_DIR=/tmp/jupiter-pose
LOG_LEVEL=INFO
