# ─────────────────────────────────────────────────────────────────────────────
# Apex Vision — PRODUCTION environment (Hetzner VPS)
#
#   cp .env.prod.example .env.prod   &&   edit   &&   keep it OUT of git.
#
# Used by:  docker compose -f docker-compose.yml -f docker-compose.prod.yml \
#                          --env-file .env.prod up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain ───────────────────────────────────────────────────────────────────
# Your real domain. Point BOTH of these A records at the VPS public IP:
#   apex.example.com        →  <VPS_IP>
#   storage.apex.example.com →  <VPS_IP>
APEX_DOMAIN=apex.example.com

# ── Database (use a STRONG password — this is a public server) ────────────────
DB_USER=apex
DB_PASSWORD=__CHANGE_ME_long_random__
DB_NAME=jupiter

# ── Auth (generate: openssl rand -hex 32) ────────────────────────────────────
JWT_SECRET=__CHANGE_ME_openssl_rand_hex_32__
JWT_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_HOURS=168

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=apex
RABBITMQ_PASS=__CHANGE_ME__

# ── Object storage (MinIO) ───────────────────────────────────────────────────
MINIO_ACCESS_KEY=apexminio
MINIO_SECRET_KEY=__CHANGE_ME_long_random__
MINIO_BUCKET=jupiter-videos
# Public endpoint the BROWSER uses for presigned upload/download URLs. Must be
# the storage subdomain fronted by Caddy over HTTPS (no scheme, no trailing /).
MINIO_PUBLIC_ENDPOINT=storage.apex.example.com
MINIO_PUBLIC_USE_SSL=true

# ── CORS ─────────────────────────────────────────────────────────────────────
# Single-origin deploy: the frontend is same-origin as the API, so this only
# needs your own domain.
CORS_ALLOW_ORIGIN=https://apex.example.com

# ── AI providers (real-time agent + batch pipeline) ──────────────────────────
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# ── Billing (Stripe) ─────────────────────────────────────────────────────────
# Setting STRIPE_SECRET_KEY turns wallet enforcement ON (BILLING_ENFORCED=1 to
# force it regardless). Leave the secret empty to run without billing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SCALE=
STRIPE_PRICE_TOPUP_S=
STRIPE_PRICE_TOPUP_M=
STRIPE_PRICE_TOPUP_L=
# Stripe Checkout return pages (served by the frontend, same origin):
BILLING_SUCCESS_URL=https://apex.example.com/billing-success.html
BILLING_CANCEL_URL=https://apex.example.com/billing-cancel.html
# BILLING_ENFORCED=1
