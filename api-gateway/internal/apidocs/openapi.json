{
  "openapi": "3.0.3",
  "info": {
    "title": "Jupiter API",
    "description": "AI-powered sales evaluation platform. Evaluates video recordings across pose, speech and prosody dimensions.",
    "version": "1.0.0",
    "contact": {
      "name": "Jupiter RIWI",
      "url": "https://github.com/Jupiter-riwi/jupiter"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      },
      "TokenPair": {
        "type": "object",
        "properties": {
          "access_token": { "type": "string" },
          "refresh_token": { "type": "string" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["admin", "user"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "text": { "type": "string" },
          "category": { "type": "string", "enum": ["sales", "product", "communication", "objection_handling"] },
          "expected_duration": { "type": "integer", "description": "Expected answer duration in seconds" }
        }
      },
      "Evaluation": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "user_id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "uploading", "processing", "completed", "failed"]
          },
          "score": { "type": "number", "format": "float", "nullable": true },
          "features": { "type": "object", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "EvaluationCreated": {
        "type": "object",
        "properties": {
          "evaluation_id": { "type": "string", "format": "uuid" },
          "upload_url": { "type": "string", "description": "Presigned MinIO PUT URL (15 min TTL)" }
        }
      },
      "PaginatedEvaluations": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Evaluation" }
          },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "total": { "type": "integer" }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Returns OK when the gateway is running.",
        "tags": ["Health"],
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string", "example": "ok" } }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "summary": "Register a new user",
        "description": "Creates a new user account scoped to an existing tenant.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["tenant_id", "email", "password"],
                "properties": {
                  "tenant_id": { "type": "string", "format": "uuid" },
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenPair" }
              }
            }
          },
          "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "409": { "description": "Email already registered in this tenant", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Authenticate",
        "description": "Returns a short-lived access token (15 min) and a long-lived refresh token (168 h).",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "format": "email" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authenticated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenPair" }
              }
            }
          },
          "401": { "description": "Invalid credentials", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "Refresh tokens",
        "description": "Exchanges a valid refresh token for a new token pair.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refresh_token"],
                "properties": {
                  "refresh_token": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New token pair issued",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TokenPair" }
              }
            }
          },
          "401": { "description": "Invalid or expired refresh token", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/me": {
      "get": {
        "summary": "Get current user",
        "description": "Returns the authenticated user's profile.",
        "tags": ["Auth"],
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/User" }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/questions": {
      "get": {
        "summary": "List practice questions",
        "description": "Returns all questions scoped to the authenticated tenant. Supports filtering and pagination.",
        "tags": ["Questions"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "schema": { "type": "string", "enum": ["sales", "product", "communication", "objection_handling"] }
          },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 } }
        ],
        "responses": {
          "200": {
            "description": "Question list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Question" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/evaluations": {
      "get": {
        "summary": "List evaluations",
        "description": "Paginated list of evaluations for the authenticated user.",
        "tags": ["Evaluations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 10 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["pending", "uploading", "processing", "completed", "failed"] } }
        ],
        "responses": {
          "200": {
            "description": "Paginated evaluation list",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedEvaluations" }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      },
      "post": {
        "summary": "Create evaluation",
        "description": "Creates an evaluation record and returns a presigned MinIO URL for direct video upload. Copy the evaluation id to the `evaluation_id` environment variable.",
        "tags": ["Evaluations"],
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "example": "Q1 Sales Pitch Demo" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Evaluation created, presigned upload URL included",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EvaluationCreated" }
              }
            }
          },
          "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/evaluations/{id}": {
      "get": {
        "summary": "Get evaluation",
        "description": "Returns the current status, score and features for an evaluation. Poll until `status=completed`.",
        "tags": ["Evaluations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "200": {
            "description": "Evaluation details",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Evaluation" }
              }
            }
          },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/evaluations/{id}/complete": {
      "post": {
        "summary": "Complete evaluation (trigger analysis)",
        "description": "Marks the video as uploaded and publishes pose, whisper and prosody jobs to RabbitMQ. Returns 202 Accepted.",
        "tags": ["Evaluations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "202": { "description": "Analysis jobs queued" },
          "400": { "description": "Evaluation already processing or completed", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } },
          "404": { "description": "Not found", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    },
    "/evaluations/{id}/stream": {
      "get": {
        "summary": "Stream evaluation progress (WebSocket)",
        "description": "WebSocket connection for real-time evaluation progress. Upgrade with `Connection: Upgrade` and `Upgrade: websocket`. Events: `connected`, `status_changed`, `completed`, `error`.",
        "tags": ["Evaluations"],
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }
        ],
        "responses": {
          "101": { "description": "WebSocket upgrade successful" },
          "401": { "description": "Unauthorized", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } } }
        }
      }
    }
  },
  "tags": [
    { "name": "Health", "description": "Service health checks" },
    { "name": "Auth", "description": "Registration, login and token management" },
    { "name": "Questions", "description": "Practice questions scoped to the tenant" },
    { "name": "Evaluations", "description": "Full evaluation lifecycle: create → upload → process → stream results" }
  ]
}
