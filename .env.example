# =============================================================================
# JÚPITER - Variables de Entorno
# Copiar este archivo a .env y ajustar valores según el entorno
# =============================================================================

# ─── Supabase (producción / staging) ─────────────────────────────────────────
SUPABASE_URL=https://bnnwbmdtmbqgpuuaqwjv.supabase.co
SUPABASE_ANON_KEY=            # Dashboard > Settings > API > anon public
SUPABASE_SERVICE_ROLE_KEY=    # Dashboard > Settings > API > service_role (solo backend/workers)

# Conexión directa a Postgres de Supabase (para workers y gateway)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.bnnwbmdtmbqgpuuaqwjv.supabase.co:5432/postgres

# ─── PostgreSQL local (docker-compose dev) ───────────────────────────────────
DB_HOST=postgres
DB_USER=jupiter
DB_PASSWORD=jupiter_secret
DB_NAME=jupiter_db
DB_PORT=5432

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── API Gateway ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
JWT_SECRET=change-me-to-a-random-secret

# ─── AI Workers ──────────────────────────────────────────────────────────────
AI_WORKERS_PORT=8000
POSE_SEGMENT_SECONDS=5
POSE_MAX_VIDEO_SECONDS=600

# ─── Storage (S3 / MinIO para workers) ──────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=               # platform.openai.com/api-keys

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
VITE_SUPABASE_URL=https://bnnwbmdtmbqgpuuaqwjv.supabase.co
VITE_SUPABASE_ANON_KEY=       # igual que SUPABASE_ANON_KEY
