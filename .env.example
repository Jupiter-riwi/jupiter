# =============================================================================
# JÚPITER - Variables de Entorno
# Copiar este archivo a .env y ajustar valores según el entorno
# =============================================================================

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_USER=jupiter
DB_PASSWORD=jupiter_secret
DB_NAME=jupiter_db
DB_PORT=5432

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# ─── API Gateway ─────────────────────────────────────────────────────────────
API_GATEWAY_PORT=8080
JWT_SECRET=change-me-to-a-random-secret

# ─── AI Workers ──────────────────────────────────────────────────────────────
AI_WORKERS_PORT=8000

# ─── Frontend ────────────────────────────────────────────────────────────────
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8080
